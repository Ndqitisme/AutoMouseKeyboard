<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net6.0-windows;netcoreapp3.1</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AutoMouseKeyboard</RootNamespace>
    <AssemblyName>AutoMouseKeyboard</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Company>AutoMouseKeyboard</Company>
    <Product>AutoMouseKeyboard</Product>
    <Authors>AutoMouseKeyboard</Authors>
    <Description>AutoMouseKeyboard - Auto click/keyboard tool</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Single-file compression is .NET 6+ only; the netcoreapp3.1 (Win7) target
       doesn't support it (NETSDK1167), so scope it to the net6 build. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0-windows'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\app.ico" />
    <EmbeddedResource Include="assets\app.png" />
    <EmbeddedResource Include="assets\qr.jpg" />
  </ItemGroup>

</Project>